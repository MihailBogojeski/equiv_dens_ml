# Path configuration for equiv_dens_ml
# Copy to paths.env and adjust for your system, then: source config/paths.env

# Root of the equiv_dens_ml repository (parent of config/, src/, paper/)
export EQUIV_DENS_ROOT="${EQUIV_DENS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Scratch directory for HPC (SLURM jobs, large outputs)
# On Greene: /scratch/$USER/equiv-paper/equiv_dens_ml
export SCRATCH_DIR="${SCRATCH_DIR:-$EQUIV_DENS_ROOT}"

# CuPy cache directory (for GPU acceleration)
export CUPY_CACHE_DIR="${CUPY_CACHE_DIR:-/tmp/cupy_cache}"
